{
  "name": "hayavo-meet-client",
  "version": "1.1.2",
  "description": "Official JavaScript client SDK for Hayavo Meet video, audio, screen sharing, real-time communication, and collaboration.",
  "type": "module",
  "main": "./dist/hayavo-meet-client.umd.min.js",
  "module": "./dist/hayavo-meet-client.esm.mjs",
  "exports": {
    ".": {
      "import": "./dist/hayavo-meet-client.esm.mjs",
      "require": "./dist/hayavo-meet-client.umd.min.js",
      "default": "./dist/hayavo-meet-client.umd.min.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c"
  },
  "keywords": [
    "hayavo",
    "hayavo-meet",
    "webrtc",
    "rtc",
    "video",
    "audio",
    "video-conferencing",
    "video-call",
    "screen-share",
    "screensharing",
    "real-time",
    "rtm",
    "chat"
  ],
  "author": "Hayavo",
  "license": "MIT",
  "homepage": "https://meet.hayavo.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/hayavo/hayavo-meet-client.git"
  },
  "bugs": {
    "url": "https://github.com/hayavo/hayavo-meet-client/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.61.0"
  }
}
